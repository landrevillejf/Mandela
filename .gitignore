# ---------------------------------------------------------------------------
# Gradle
# ---------------------------------------------------------------------------
# Gradle's own cache/daemon directory, and the build output. This project
# redirects its build directory to build-gradle/ (build.gradle:
# `layout.buildDirectory = file('build-gradle')`), so BOTH the default build/
# and build-gradle/ are ignored -- the jar, the JaCoCo/Cucumber/PIT reports,
# the javadoc and the scratch harnesses all live under build-gradle/ and are
# regenerated, never tracked. The wrapper under gradle/wrapper/ IS tracked on
# purpose: only the output is ignored, not the build definition.
.gradle/
build/
build-gradle/

# ---------------------------------------------------------------------------
# IntelliJ IDEA
# ---------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
out/

# ---------------------------------------------------------------------------
# Eclipse / NetBeans / VS Code
# ---------------------------------------------------------------------------
.classpath
.project
.settings/
nbproject/private/
nbbuild/
nbdist/
.vscode/

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# ---------------------------------------------------------------------------
# Logs, crash dumps and JVM replays
# ---------------------------------------------------------------------------
*.log
hs_err_pid*
replay_pid*
